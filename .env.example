DATABASE_URL=postgresql://dupla:dupla@localhost:5432/dupla
POSTGRES_USER: dupla
POSTGRES_PASSWORD: dupla
POSTGRES_DB: dupla

# Documentación de la API (/docs). Por default se sirve salvo NODE_ENV=production;
# descomentar solo para forzar el otro lado (apagarla en dev, o prenderla en un deploy).
# SWAGGER_ENABLED=false

# Firma los access tokens (JWT). Requerido: la API no arranca sin esto
# (`AuthModule` usa `getOrThrow`). Cualquier string en dev; en un deploy
# real, un secreto largo y aleatorio, no este valor de ejemplo. El
# vencimiento (7 días) no es configurable por env: es la constante
# `ACCESS_TOKEN_TTL_SECONDS` en `apps/api/src/auth/auth.service.ts`.
JWT_SECRET=dev-only-change-me

# Mercado Pago recurring billing. Required only when POST /subscriptions/me/checkouts is enabled.
# Prices are server-owned decimal amounts; never accept them from the client.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_BASIC_AMOUNT=
MERCADO_PAGO_PRO_AMOUNT=
MERCADO_PAGO_CURRENCY=ARS
MERCADO_PAGO_BACK_URL=http://localhost:3000/billing/return
# Public HTTPS endpoint Mercado Pago calls for signed billing notifications.
MERCADO_PAGO_WEBHOOK_URL=
# Secret used to verify Mercado Pago's x-signature webhook header.
MERCADO_PAGO_WEBHOOK_SECRET=
